FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    AGENTSOUL_HOST=0.0.0.0 \
    AGENTSOUL_PORT=8000 \
    AGENTSOUL_HOME=/data/agentsoul

WORKDIR /app
COPY pyproject.toml /app/
COPY agentsoul_core /app/agentsoul_core
COPY agentsoul_mcp /app/agentsoul_mcp
RUN python -m pip install --no-cache-dir .

RUN useradd --create-home --uid 10001 agentsoul \
    && mkdir -p /data/agentsoul \
    && chown -R agentsoul:agentsoul /data/agentsoul /app
USER agentsoul

VOLUME ["/data/agentsoul"]
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=3)"
CMD ["agentsoul-mcp"]
