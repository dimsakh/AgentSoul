[Unit]
Description=AgentSoul memory service
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/agentsoul/deploy/vps
EnvironmentFile=/etc/agentsoul/agentsoul.env
ExecStart=/usr/bin/docker compose --env-file /etc/agentsoul/agentsoul.env up -d --build --remove-orphans
ExecReload=/usr/bin/docker compose --env-file /etc/agentsoul/agentsoul.env up -d --build --remove-orphans
ExecStop=/usr/bin/docker compose --env-file /etc/agentsoul/agentsoul.env down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
