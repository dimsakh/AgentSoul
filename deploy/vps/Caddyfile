{
    email {$ACME_EMAIL}
    admin off
}

{$AGENTSOUL_DOMAIN} {
    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        -Server
    }

    reverse_proxy agentsoul:8000
}
